{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "country",
    "licence_class",
    "topic",
    "question",
    "answers",
    "correct",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Za-z0-9]+-[0-9]+$"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "licence_class": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "correct": {
      "type": "integer",
      "minimum": 0
    },
    "explanation": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    }
  }
}
